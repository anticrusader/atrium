# Hermes Agora — config template. Copy to .env and fill in your key.
#   cp .env.example .env
# .env is gitignored; this template is safe to commit.

# OpenRouter key — get one (free) at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which model(s) the real executor uses. OpenAI-compatible providers:
#   OpenRouter: https://openrouter.ai/api/v1   (free :free slugs; rotate/429 often)
#   Groq:       https://api.groq.com/openai/v1 model e.g. llama-3.1-8b-instant   (set GROQ_API_KEY)
#   Local 3090: http://localhost:11434/v1      model e.g. hermes3:8b (Ollama; OPENROUTER_API_KEY=ollama)
#
# LLM_MODEL is a COMMA-SEPARATED FALLBACK LIST — the executor rotates to the next
# model on a 429 (free models share global capacity and get throttled).
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b:free,openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free

# Requests/min budget shared across the whole fleet (free tier ~20/min, ~200/day).
LLM_RPM=15

# WIP limit: how many tasks run at once (lower = steadier progress when throttled).
MAX_CONCURRENT=6

# Orchestrator overrides (optional)
# PORT=8787
# HOST=127.0.0.1
# TICK_MS=1100
