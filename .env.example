# Hermes Agora — config template. Copy to .env and fill in your key.
#   cp .env.example .env
# .env is gitignored; this template is safe to commit.

# OpenRouter key — get one (free) at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which model the real executor uses. OpenAI-compatible providers:
#   OpenRouter: https://openrouter.ai/api/v1   model e.g. nousresearch/hermes-3-llama-3.1-405b:free
#   Groq:       https://api.groq.com/openai/v1 model e.g. llama-3.1-8b-instant   (set GROQ_API_KEY)
#   Local 3090: http://localhost:11434/v1      model e.g. hermes3:8b (Ollama; key can be any non-empty string)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b:free

# Orchestrator overrides (optional)
# PORT=8787
# HOST=127.0.0.1
# TICK_MS=1100
