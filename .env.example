# Hermes Agora — config template. Copy to .env and fill in your key.
#   cp .env.example .env
# .env is gitignored; this template is safe to commit.

# OpenRouter key — get one (free) at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM_PROVIDER picks the key + default base URL. All are OpenAI-compatible.
#   nvidia     → NVIDIA_API_KEY,     https://integrate.api.nvidia.com/v1  (generous free tier — recommended)
#   openrouter → OPENROUTER_API_KEY, https://openrouter.ai/api/v1         (free :free slugs; throttle often)
#   groq       → GROQ_API_KEY,       https://api.groq.com/openai/v1
#   ollama     → LLM_API_KEY=ollama, http://localhost:11434/v1            (local GPU; no limits)
#
# LLM_MODEL is a COMMA-SEPARATED FALLBACK LIST — the executor rotates to the next
# model on a 429.
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct,nvidia/llama-3.3-nemotron-super-49b-v1,meta/llama-3.1-8b-instruct

# Requests/min shared across the whole fleet.
LLM_RPM=30

# WIP limit: how many tasks run at once.
MAX_CONCURRENT=8

# Orchestrator overrides (optional)
# PORT=8787
# HOST=127.0.0.1
# TICK_MS=1100

# ── Email skill (Outlook / Microsoft Graph) — OPTIONAL, draft-only ─────────────
# Lets the `email`-skilled agent READ your Outlook inbox and DRAFT replies. It
# NEVER sends. Leave EMAIL_CLIENT_ID blank to disable the skill entirely.
# Setup: register a public-client app in Azure with delegated Graph permissions
#   Mail.Read + Mail.ReadWrite + offline_access (see server/email.js header),
#   put its Application (client) ID below, then run:  npm run email:login
# EMAIL_CLIENT_ID=
# EMAIL_TENANT=consumers   # 'consumers' for personal outlook.com; 'common' otherwise
